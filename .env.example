# Shared application settings
PORT=3000
NODE_ENV=development
DB_LOGGING=false

JWT_SECRET=troque_por_uma_chave_aleatoria_com_pelo_menos_32_caracteres
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,https://localhost,https://nexus.store

DB_NAME=nexus_store
DB_USER=troque_esse_usuario
DB_PASSWORD=troque_essa_senha
DB_HOST=localhost
DB_PORT=5434

VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3001

# Expo Go no celular: use o IP da máquina na rede local
EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:3001
REACT_NATIVE_PACKAGER_HOSTNAME=SEU_IP_LOCAL

# Porta do backend publicada para o celular e ferramentas locais
BACKEND_PORT_HOST=3001

# Docker internal network
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432
REDIS_PORT_HOST=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Mídia em produção: bucket público; chave secreta somente no backend
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# Proteção do endpoint agendado de reconciliação de pagamentos
CRON_SECRET=

# Pagamentos: segredo compartilhado apenas entre backend e microserviço (mínimo 32 caracteres)
PAYMENTS_SERVICE_SECRET=
PAYMENTS_SERVICE_URL=http://localhost:3002
PAYMENTS_PORT=3002
PAYMENTS_PORT_HOST=3002
BACKEND_INTERNAL_URL=http://localhost:3000
# Origem do frontend para o retorno do checkout; no mobile, volte ao app após pagar
PAYMENTS_RETURN_URL=https://nexus.store
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# URL HTTPS pública que encaminha /payments/webhook ao Nginx (túnel em desenvolvimento)
MERCADO_PAGO_WEBHOOK_URL=https://SEU_DOMINIO_PUBLICO/payments/webhook
MERCADO_PAGO_SANDBOX=true

# Docker storage
POSTGRES_DATA_PATH_HOST=./.docker/postgres
BACKEND_STORAGE_PATH_HOST=./.docker/backend-storage
