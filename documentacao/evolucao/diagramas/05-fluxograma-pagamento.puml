@startdot
digraph Pagamento {
  graph [bgcolor="white", rankdir=TB, pad=0.35, nodesep=0.4, ranksep=0.45,
    fontname="DejaVu Sans", fontsize=20, label="Fluxo de pagamento", labelloc=t];
  node [shape=box, style="filled", fillcolor="#EFF6FF", color="#2563EB",
    fontname="DejaVu Sans", fontsize=13, margin="0.18,0.12"];
  edge [color="#475569", fontname="DejaVu Sans", fontsize=11, arrowsize=0.7];

  inicio [shape=oval, fillcolor="#DBEAFE", label="Início"];
  revisar [label="Revisar carrinho e\nescolher forma de pagamento"];
  validar [shape=diamond, label="Preços e estoque\nválidos?"];
  corrigir [label="Informar problema\ne solicitar revisão"];
  reservar [label="Criar pedido pendente\ne reservar chaves"];
  cobrar [label="Criar ou recuperar cobrança\ne mostrar instruções"];
  aguardar [label="Aguardar pagamento\nou atualização do gateway"];
  verificar [label="Validar atualização\ne consultar pagamento"];
  confirmado [shape=diamond, label="Pagamento\naprovado?"];
  terminal [shape=diamond, label="Pagamento encerrado\nsem aprovação?"];
  encerrar [label="Atualizar pedido e liberar\na reserva após confirmação"];
  estoque [shape=diamond, label="Chaves disponíveis\npara este pedido?"];
  entregar [label="Marcar como pago e\nregistrar entrega das chaves"];
  estornar [label="Registrar pagamento e falha;\nsolicitar estorno integral"];
  avisar [label="Exibir situação do pedido\ne enviar aviso por e-mail"];
  fim [shape=oval, fillcolor="#DBEAFE", label="Fim"];

  inicio -> revisar -> validar;
  validar -> reservar [label="Sim"];
  validar -> corrigir [label="Não"];
  corrigir -> revisar;
  reservar -> cobrar -> aguardar -> verificar -> confirmado;
  confirmado -> estoque [label="Sim"];
  confirmado -> terminal [label="Não"];
  terminal -> encerrar [label="Sim"];
  terminal -> aguardar [label="Não: pendente"];
  encerrar -> avisar;
  estoque -> entregar [label="Sim"];
  estoque -> estornar [label="Não"];
  entregar -> avisar;
  estornar -> avisar;
  avisar -> fim;
}
@enddot
