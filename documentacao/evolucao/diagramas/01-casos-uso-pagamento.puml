@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam dpi 140
skinparam ArrowColor #475569
skinparam usecaseBackgroundColor #EFF6FF
skinparam usecaseBorderColor #2563EB
skinparam rectangleBorderColor #94A3B8
skinparam nodesep 45
skinparam ranksep 65
title Pagamentos — casos de uso

actor Cliente as C
actor "Gateway de pagamento" as G
actor "Serviço de e-mail" as E

rectangle "Sistema Nexus" {
  usecase "Iniciar compra" as Compra
  usecase "Escolher forma\nde pagamento" as Metodo
  usecase "Gerar cobrança" as Cobranca
  usecase "Confirmar pagamento\naprovado" as Confirmar
  usecase "Liberar chaves\nna biblioteca" as Liberar
  usecase "Enviar confirmação\npor e-mail" as Email
  usecase "Consultar pedido" as Pedido
  usecase "Visualizar chaves" as Chaves
}

C -- Compra
C -- Pedido
C -- Chaves
Compra ..> Metodo : <<include>>
Compra ..> Cobranca : <<include>>
Cobranca -- G
Confirmar -- G
Confirmar ..> Liberar : <<include>>
Confirmar ..> Email : <<include>>
Email -- E
Chaves ..> Pedido : <<extend>>\n[cliente solicita; chaves liberadas]
@enduml
